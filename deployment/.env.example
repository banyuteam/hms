# Copy to deployment/.env (git-ignored) for the local development stack (compose.yaml). Non-secret settings only:
# passwords and keys are files under HMS_SECRETS_DIR (deployment/README.md). Never commit a populated .env.

COMPOSE_PROJECT_NAME=hms
POSTGRES_IMAGE=postgres:18
# Host port for psql against the container (loopback only). 5433 avoids a local PostgreSQL on 5432.
POSTGRES_PORT=5433
HMS_DATABASE_NAME=hms
# Relative to deployment/. Holds the six secret files listed in deployment/README.md.
HMS_SECRETS_DIR=./secrets/dev

# Tenant and facility rows created by the org-setup job (codes: A-Z, 0-9, _ and -).
HMS_ORGANIZATION_CODE=RSUB2
HMS_ORGANIZATION_NAME=RSU Banyumanik 2
HMS_FACILITY_CODE=RSUB2-MAIN
HMS_FACILITY_NAME=RSU Banyumanik 2
HMS_FACILITY_TIMEZONE=Asia/Jakarta

# Legacy HMS (Khanza MySQL): a dedicated SELECT-only account, never the Khanza application account.
# A development Khanza on this machine is reachable as host.docker.internal.
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_LOGIN_EMPLOYEE_FIELD=nik

LOG_LEVEL=info
HMS_SERVICES_IMAGE=local/hms-services:dev

# Web: browse to http://127.0.0.1:<HMS_WEB_HTTP_PORT> exactly (it is hms-services' PUBLIC_ORIGIN).
HMS_WEB_HTTP_PORT=8088
HMS_WEB_IMAGE=local/hms-web:dev
# Public, non-secret build settings compiled into the browser bundle. bff = live data through hms-services.
VITE_DATA_SOURCE=bff
VITE_IDLE_MINUTES=15

# Private bridge network; change both if 172.28.50.0/24 collides with a local network.
HMS_NETWORK_SUBNET=172.28.50.0/24
HMS_WEB_IP=172.28.50.10
