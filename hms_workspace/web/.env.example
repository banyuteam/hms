# Only non-secret, browser-visible configuration belongs here (Vite exposes VITE_* to the bundle).
# Never put passwords, API keys, BPJS/E-Klaim credentials or e-sign secrets in any VITE_ variable.

# Static demo account (login/logout demo only, NO real authentication). Disabled unless "true".
VITE_DEMO_AUTH=false
# Idle minutes before the session is ended automatically (demo stand-in for auto-lock).
VITE_IDLE_MINUTES=15
# Simulated latency of the synthetic data adapter in ms (default 150; tests use 0).
VITE_MOCK_LATENCY_MS=150

# Data source (build choice): "bff" = real data and sign-in through hms-services (same origin, /api proxied; README "Live
# data"); anything else = synthetic demo data. Never guessed at runtime. ("bff" is the historical name of this switch.)
VITE_DATA_SOURCE=
# HMS_SERVICES_TARGET=http://127.0.0.1:8080   (dev proxy target for /api; read by vite.config.ts only, loopback only)
# hms-services must then run with PUBLIC_ORIGIN=http://127.0.0.1:5174 (this dev server's origin).
# Dev HTTPS (file paths, both or neither; required for `vite --host` with live data — README "Testing from other machines").
# Keep the files outside the repository.
# HMS_DEV_TLS_CERT=C:\Users\<you>\.hms-dev-tls\cert.pem
# HMS_DEV_TLS_KEY=C:\Users\<you>\.hms-dev-tls\key.pem
