# Copy to .env and fill in from the secret store. Never commit .env.
# Works the same on Windows and Ubuntu; real environment variables override this file.

# --- Source: Khanza MariaDB 10.6 READ-ONLY REPLICA (never the primary) ---
# The user must have SELECT on the allowlisted tables only; the service refuses to start otherwise.
CDC_SOURCE_HOST=replica.example.internal
CDC_SOURCE_PORT=3306
CDC_SOURCE_USER=cdc_reader
CDC_SOURCE_PASSWORD=change-me
CDC_SOURCE_DATABASE=khanza
# Optional: path to the CA certificate for TLS to the replica
CDC_SOURCE_SSL_CA=
CDC_SOURCE_CONNECT_TIMEOUT_S=10
# Server-side kill switch for any single statement (SET SESSION max_statement_time)
CDC_SOURCE_MAX_STATEMENT_TIME_S=60
# Pause when the replica is this many seconds behind (0 = off; needs REPLICA MONITOR, optional)
CDC_MAX_REPLICA_LAG_S=0

# --- Target: PostgreSQL 18 (schemas cdc + khanza_mirror from hms_database/cdc-polling) ---
CDC_TARGET_HOST=localhost
CDC_TARGET_PORT=5432
CDC_TARGET_USER=cdc_polling
CDC_TARGET_PASSWORD=change-me
CDC_TARGET_DATABASE=hms_cdc
CDC_TARGET_SSLMODE=prefer

# --- Engine / throttling ---
# Folder with <table>.yaml mappings (relative paths are relative to the project folder)
CDC_MAPPINGS_DIR=mappings
CDC_MAX_RANGES_PER_PASS=200
CDC_THROTTLE_SLEEP_MS=0
# Token bucket on rows read from the replica per second (0 = unlimited)
CDC_MAX_SOURCE_ROWS_PER_SECOND=0
CDC_FETCH_BATCH_SIZE=200
CDC_IDLE_SLEEP_S=5
CDC_LOG_LEVEL=INFO
