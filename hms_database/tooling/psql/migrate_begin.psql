-- Migration session preamble (ADR-DB-001). Included by the plan that scripts/migrate.{ps1,sh} generates.
-- Inputs (psql variables): hms_plan (true = report only), hms_all_versions (comma-separated versions on disk).
\set ON_ERROR_STOP on
SET client_min_messages = warning;
SET lock_timeout = '10s';

-- Migrations run as the database owner role, so every object is owned by it and not by the login that ran them.
SELECT pg_get_userbyid(d.datdba) AS hms_db_owner,
       pg_has_role(current_user, d.datdba, 'SET') AS hms_can_set_owner
FROM pg_database d WHERE d.datname = current_database() \gset
\if :hms_can_set_owner
\else
  SELECT format('%s cannot SET ROLE to the database owner %s; run migrations as the migrator login', current_user, :'hms_db_owner') AS hms_error \gset
  \ir fail.psql
\endif
SET ROLE :"hms_db_owner";

-- One runner at a time per database; held until the session ends.
SELECT pg_try_advisory_lock(hashtext('hms_database.migrate')) AS hms_got_lock \gset
\if :hms_got_lock
\else
  \set hms_error 'another migration run holds the lock on this database'
  \ir fail.psql
\endif

\if :hms_plan
  SET default_transaction_read_only = on;
  SELECT to_regclass('hms_meta.schema_migrations') IS NOT NULL AS hms_ledger_exists \gset
\else
  CREATE SCHEMA IF NOT EXISTS hms_meta;
  COMMENT ON SCHEMA hms_meta IS 'hms_database: migration ledger and shared database utilities';
  CREATE TABLE IF NOT EXISTS hms_meta.schema_migrations (
      version      text        NOT NULL,
      name         text        NOT NULL,
      checksum     text        NOT NULL,
      applied_at   timestamptz NOT NULL DEFAULT clock_timestamp(),
      applied_by   text        NOT NULL DEFAULT session_user,
      duration_ms  integer     NOT NULL,
      CONSTRAINT pk_schema_migrations PRIMARY KEY (version),
      CONSTRAINT ck_schema_migrations_version CHECK (version ~ '^[0-9]{4}$'),
      CONSTRAINT ck_schema_migrations_checksum CHECK (checksum ~ '^[0-9a-f]{64}$')
  );
  COMMENT ON TABLE hms_meta.schema_migrations IS
      'One row per applied migration; checksum is SHA-256 of the file with CR bytes removed';
  \set hms_ledger_exists true
\endif

\if :hms_ledger_exists
  SELECT coalesce(max(version), '0000') AS hms_max_applied,
         coalesce(string_agg(version, ',' ORDER BY version)
                  FILTER (WHERE version <> ALL (string_to_array(:'hms_all_versions', ','))), '') AS hms_unknown
  FROM hms_meta.schema_migrations \gset
  SELECT :'hms_unknown' = '' AS hms_no_unknown \gset
  \if :hms_no_unknown
  \else
    SELECT 'applied migrations missing from migrations/: ' || :'hms_unknown' AS hms_error \gset
    \ir fail.psql
  \endif
\else
  \set hms_max_applied '0000'
\endif
