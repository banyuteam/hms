{
  "name": "hms-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HMS web workspace SPA (React 18.3 + TypeScript 5.7 + Vite 6 + Tailwind CSS 3.4). Banyumanik 2 EMR remodel; see README.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "host": "vite --host"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.56.4",
    "react-router-dom": "6.30.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "axe-core": "4.10.3",
    "eslint": "9.28.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
