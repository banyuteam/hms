# Only non-secret, browser-visible configuration belongs here (Vite exposes VITE_* to the bundle).
# Never put passwords, API keys, BPJS/E-Klaim credentials or e-sign secrets in any VITE_ variable.

# Static demo account (login/logout demo only, NO real authentication). Disabled unless "true".
VITE_DEMO_AUTH=false
# Idle minutes before the session is ended automatically (demo stand-in for auto-lock).
VITE_IDLE_MINUTES=15
