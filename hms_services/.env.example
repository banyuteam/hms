# hms-services configuration. Copy to .env (git-ignored) for local development and run
#   go run ./cmd/hms-services -env-file .env serve
# Placeholders only: never commit real hosts, passwords or keys. Any secret NAME may instead be given as NAME_FILE
# (path to a protected file), which is the required form outside development.

APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8080
# Exact origin the browser uses (scheme://host[:port]); the hms_workspace web dev server is http://127.0.0.1:5174.
# State-changing requests must come from it. https in production.
PUBLIC_ORIGIN=http://127.0.0.1:5174
# Reverse proxy address(es) whose X-Real-IP header is trusted (IPs or CIDRs). Empty = use the TCP peer.
TRUSTED_PROXIES=

# Tenant and facility (create them once: hms-services setup-organization ...)
HMS_ORGANIZATION_CODE=RSUB2
HMS_FACILITY_CODE=RSUB2-MAIN

# --- HMS PostgreSQL (hms_database), runtime role only: never the migrator or a superuser ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=hms
DATABASE_USER=hms_meta_runtime
DATABASE_PASSWORD=
# DATABASE_PASSWORD_FILE=
# disable | prefer (dev default) | require | verify-ca | verify-full (production: verify-ca or verify-full)
DATABASE_SSLMODE=prefer
DATABASE_MAX_CONNS=10

# --- Legacy HMS (Khanza, MySQL/MariaDB): dedicated SELECT-only account, never the Khanza application account ---
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# LEGACY_DB_PASSWORD_FILE=
LEGACY_DB_TIMEOUT_SECONDS=5
LEGACY_DB_MAX_CONNS=5

# Khanza AES keys for user.id_user and user.password (exactly as Khanza uses them). Among the most sensitive secrets
# of the system: with read access to `user` they recover every staff password. Use the _FILE form outside dev.
LEGACY_LOGIN_ID_KEY=
LEGACY_LOGIN_PASSWORD_KEY=
# LEGACY_LOGIN_ID_KEY_FILE=
# LEGACY_LOGIN_PASSWORD_KEY_FILE=
# pegawai column that Khanza user IDs hold for employees (reference default nik; verify on your data)
LEGACY_LOGIN_EMPLOYEE_FIELD=nik

# --- Sessions and sign-in protection ---
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
# How long "still active in Khanza" is reused before re-checking (0 = every request)
LEGACY_ACTIVE_CACHE_SECONDS=300
SIGNIN_LOCKOUT_FAILURES=5
SIGNIN_LOCKOUT_WINDOW_MINUTES=15
SIGNIN_LOCKOUT_MINUTES=15
# Per client address, per process (the ingress must also rate-limit when there are several replicas)
SIGNIN_RATE_PER_MINUTE=20

# --- Legacy bridge worker (`hms-services legacy-bridge`, ADR-ROOT-002 / ADR-SVC-010) ---
# Runs as a separate process with its OWN environment: DATABASE_USER=hms_meta_legacy_bridge and that login's
# password (never the runtime's), the same HMS_ORGANIZATION_CODE / HMS_FACILITY_CODE and the SELECT-only LEGACY_DB_*
# account. It needs no HTTP, session or LEGACY_LOGIN_* settings. serve refuses the bridge login and vice versa.
# BRIDGE_BATCH_SIZE=500
# Pause between batches of one pass (bounds the load on the legacy database)
# BRIDGE_BATCH_PAUSE_MS=1000
# Wait after a complete pass before the next one
# BRIDGE_INTERVAL_SECONDS=300

# --- Uploaded files (platform/filestore: document attachments ADR-SVC-013, catalogue ADR-SVC-012) ---
# Off unless FILES_DIR is set; then CLAMAV_ADDR is required: every upload is scanned and refused when clamd is down.
# FILES_DIR=D:/hms-files              # absolute; development: synthetic or de-identified files only
# CLAMAV_ADDR=127.0.0.1:3310          # clamd (docker compose runs it as clamav:3310)
# FILES_MAX_MB=20                     # cap for any one file (1-20); each feature may set a lower limit
