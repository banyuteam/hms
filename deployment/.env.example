# Copy to a local ignored .env file for development only.
# Never place real production secrets in this file or commit populated .env files.

COMPOSE_PROJECT_NAME=hms
POSTGRES_IMAGE=postgres:18
POSTGRES_DB=hms
POSTGRES_USER=hms_app
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=5432

HMS_SERVICES_BUILD_CONTEXT=../hms_services
HMS_SERVICES_IMAGE=local/hms-services:dev
HMS_SERVICES_HTTP_PORT=8080

HMS_WEB_BUILD_CONTEXT=../hms_workspace/web
HMS_WEB_IMAGE=local/hms-web:dev
HMS_WEB_HTTP_PORT=8088

# Public, non-secret browser configuration only.
VITE_API_BASE_URL=/api
